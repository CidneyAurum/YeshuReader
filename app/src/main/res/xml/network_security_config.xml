<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dynamic LAN IPs cannot be enumerated in this XML. AiClient is the app's sole outbound
         network boundary (enforced by AiClientTest), validates every effective Chat/models URL,
         and only permits cleartext loopback/private hosts after explicit user confirmation.
         Public HTTP and redirects are rejected before a connection is opened. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
